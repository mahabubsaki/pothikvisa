{
  "name": "visa-auto-form-fillup",
  "version": "1.0.0",
  "description": "Browser automation for visa applications and web forms powered by Stagehand",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "web:dev": "next dev -p 3000",
    "web:build": "next build",
    "web:start": "next start -p 3000",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "fill": "tsx src/run-fill.ts",
    "resume": "tsx src/resume-fill.ts",
    "ivac": "tsx src/run-ivac.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "keywords": [
    "stagehand",
    "browserbase",
    "browser-automation",
    "ai-agent",
    "form-fill"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@browserbasehq/stagehand": "^4.1.0",
    "@clerk/nextjs": "^7.9.10",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ddddocr-node": "^2.3.0",
    "dotenv": "^18.0.5",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "mrz": "^5.0.2",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.89.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "ddddocr-node",
      "sharp"
    ]
  }
}
