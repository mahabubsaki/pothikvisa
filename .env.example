# ==============================================================================
# Model & Provider Configuration
# ==============================================================================

# Option 1: Groq DeepSeek (Ultra-fast "flash" token generation via Groq LPUs)
# Supported Groq DeepSeek models:
#   - groq/deepseek-r1-distill-llama-70b
#   - groq/deepseek-r1-distill-qwen-32b
MODEL_NAME=groq/deepseek-r1-distill-llama-70b
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini Flash models
# Supported Flash models:
#   - google/gemini-2.5-flash
#   - google/gemini-2.0-flash
#   - google/gemini-2.0-flash-lite
# MODEL_NAME=google/gemini-2.5-flash
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Direct DeepSeek API (deepseek-chat / deepseek-reasoner)
# MODEL_NAME=deepseek/deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Option 4: OpenAI or Anthropic models
# MODEL_NAME=openai/gpt-4o-mini
# MODEL_NAME=anthropic/claude-sonnet-4-5
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Generic single API key fallback (matches whichever MODEL_NAME you pick above)
MODEL_API_KEY=

# ==============================================================================
# Browser Configuration
# ==============================================================================
# Set HEADLESS=false to watch the browser fill out forms in real time!
HEADLESS=false

# Directory where browser cookies & session profile persist between runs
USER_DATA_DIR=./browser-data

# Optional: Browserbase Cloud execution
BROWSERBASE_API_KEY=
